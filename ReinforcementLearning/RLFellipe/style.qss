/* style.qss - Stylesheet for the Application */

/* General Window and Widget Style */
QWidget {
    background-color: #fdfdfe; /* A slightly off-white color */
    color: #2c3e50; /* Dark and soft text color */
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", "Arial", sans-serif;
}

/* Style for Title Labels */
QLabel#titleLabel {
    font-size: 32px;
    font-weight: bold;
    color: #34495e; /* A dark grayish-blue */
    padding-bottom: 10px;
}

/* --- Button Styles --- */

/* Base style for all buttons, for consistency */
QPushButton {
    border: 1px solid #d1d5da;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 16px;
    font-weight: bold;
    min-width: 150px;
    background-color: #fafbfc;
}

QPushButton:hover {
    background-color: #f3f4f6;
    border-color: #aeb5bc;
}

QPushButton:pressed {
    background-color: #e8eaed;
    border-color: #aeb5bc;
}

/* Style for Navigation Buttons (class "navigation") */
QPushButton[class="navigation"] {
    background-color: #3498db;
    color: white;
    border-color: #2980b9;
}
QPushButton[class="navigation"]:hover {
    background-color: #2980b9;
}
QPushButton[class="navigation"]:pressed {
    background-color: #2471a3;
}

/* Style for the Grid confirmation button */
QPushButton#confirmButton {
    background-color: #2ecc71;
    color: white;
    border-color: #27ae60;
}
QPushButton#confirmButton:hover {
    background-color: #27ae60;
}
QPushButton#confirmButton:pressed {
    background-color: #229954;
}

/* Style for the close button */
QPushButton#closeButton {
    background-color: #e74c3c;
    color: white;
    border-color: #c0392b;
}
QPushButton#closeButton:hover {
    background-color: #c0392b;
}
QPushButton#closeButton:pressed {
    background-color: #a93226;
}

/* --- Styles for Form Widgets --- */

QFormLayout > QLabel {
    font-size: 16px;
    font-weight: bold;
    color: #2c3e50;
    padding-top: 5px;
}

QComboBox, QSpinBox {
    padding: 8px;
    border: 1px solid #bdc3c7;
    border-radius: 8px;
    font-size: 15px;
    background-color: white;
    min-width: 100px;
}
QComboBox:hover, QSpinBox:hover {
    border-color: #3498db;
}
QComboBox QAbstractItemView {
    border: 1px solid #bdc3c7;
    background-color: white;
    selection-background-color: #3498db;
}

/* --- Container and Frame Styles --- */
QWidget#controlsContainer {
    background-color: #f4f6f8;
    border-radius: 10px;
    border: 1px solid #e1e4e8;
}

QWidget#slidersContainer {
    max-width: 600px;
}

/* --- Label Styles --- */
QLabel#instructionLabel {
    font-size: 15px;
    color: #586069; /* A softer gray */
    padding: 10px;
    text-align: center;
}

QLabel#trainingStatusLabel {
    font-size: 20px;
    font-weight: bold;
    color: #34495e;
    padding: 20px;
}

QLabel#statusLabel {
    font-size: 14px;
    font-weight: bold;
    padding: 8px 12px;
    border-radius: 5px;
    min-width: 200px;
    text-align: center;
}

QLabel#statusLabel[class="success"] {
    color: #27ae60;
    background-color: #eafaf1;
    border: 1px solid #a3e9a4;
}

QLabel#statusLabel[class="error"] {
    color: #c0392b;
    background-color: #ebab35;
    border: 1px solid #f5b7b1;
}

/* --- Styles for Compass Widget --- */

QLabel#compassTitle {
    font-size: 16px;
    font-weight: bold;
    color: #34495e;
    margin-bottom: 10px;
}

QLabel#compassValue {
    font-size: 20px;
    font-weight: bold;
    color: #2c3e50;
}

QPushButton#compassButton {
    font-size: 24px;
    font-weight: bold;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    padding: 0;
    border-radius: 20px; /* Make it circular */
    border: 2px solid #bdc3c7;
    background-color: white;
}

QPushButton#compassButton:hover {
    background-color: #ecf0f1;
    border-color: #3498db;
}

QPushButton#compassButton:checked {
    background-color: #3498db;
    color: white;
    border-color: #2980b9;
}

/* --- Agent Selection and Toggle Buttons --- */

QPushButton[class="agentButton"], QPushButton[class="toggleButton"] {
    background-color: white;
    color: #2c3e50;
    border: 2px solid #bdc3c7;
}

QPushButton[class="agentButton"]:hover, QPushButton[class="toggleButton"]:hover {
    border-color: #3498db;
    background-color: #ecf0f1;
}

QPushButton[class="agentButton"]:checked, QPushButton[class="toggleButton"]:checked {
    background-color: #3498db;
    color: white;
    border-color: #2980b9;
}

/* --- Slider Styles --- */

QLabel#sliderValueLabel {
    font-size: 16px;
    font-weight: bold;
    color: #3498db;
}

QSlider::groove:horizontal {
    border: 1px solid #bdc3c7;
    background: #ecf0f1;
    height: 8px;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #3498db;
    border: 1px solid #3498db;
    width: 18px;
    height: 18px;
    margin: -5px 0; /* handle is placed vertically centered */
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #2980b9;
    border-color: #2980b9;
}
